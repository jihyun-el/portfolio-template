{
  "name": "portfolio-template",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/check-content.mjs && next build && node scripts/check-export.mjs",
    "check-content": "node scripts/check-content.mjs",
    "check-types": "tsc --noEmit",
    "preview": "node scripts/preview.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  },
  "engines": { "node": ">=22" }
}
